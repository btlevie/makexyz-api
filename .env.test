TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=test
LOG_LEVEL=silent

APP_KEY=test-app-key-must-be-at-least-32-chars
APP_URL=http://localhost:3333

SESSION_DRIVER=memory

DB_CONNECTION=sqlite

AWS_PROFILE=makexyz
AWS_REGION=us-west-1
S3_BUCKET=makexyz-dev
S3_FILE_STORAGE_KEY=projects
DRIVE_DISK=s3

SLICER_CALLBACK_SECRET=test-slicer-callback-secret

# Stripe webhook signature verification is a local HMAC check (no network
# call), so tests exercise it for real rather than faking it - STRIPE_SECRET_KEY
# here is only ever used to construct the Stripe client for that local check,
# never sent to Stripe. PayPal's webhook verifier is faked in test env
# instead (it requires a real network call), so no PayPal webhook var is
# needed here.
STRIPE_SECRET_KEY=sk_test_dummy_key_for_webhook_verification
STRIPE_WEBHOOK_SECRET=whsec_test_secret_for_webhook_verification

# paypal_auth_service.spec.ts mocks fetch, so these values are never actually
# sent anywhere - only present so getPayPalAccessToken's env validation
# passes before the mocked fetch call.
PAYPAL_CLIENT_ID=test-paypal-client-id
PAYPAL_CLIENT_SECRET=test-paypal-client-secret

# In-memory so rate limit state resets between runs and needs no DB table.
LIMITER_STORE=memory
INSTANT_QUOTE_RATE_LIMIT_REQUESTS=5
INSTANT_QUOTE_RATE_LIMIT_WINDOW=1 minute
