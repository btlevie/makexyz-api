# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app

#--------------------------------------------------------------------
# AWS S3 (project file storage)
#--------------------------------------------------------------------
AWS_REGION=
S3_BUCKET=
S3_FILE_STORAGE_KEY=
DRIVE_DISK=s3

#--------------------------------------------------------------------
# Slicing microservice integration
#--------------------------------------------------------------------
SQS_SLICING_QUEUE_URL=
SLICER_CALLBACK_SECRET=

#--------------------------------------------------------------------
# Rate limiting (the instant-quote upload is public and costs money per
# call - every request writes to S3 and invokes the slicing Lambda)
#--------------------------------------------------------------------
LIMITER_STORE=database
INSTANT_QUOTE_RATE_LIMIT_REQUESTS=10
INSTANT_QUOTE_RATE_LIMIT_WINDOW=1 hour

#--------------------------------------------------------------------
# Anonymous instant-quote grants and abandoned-project cleanup
#--------------------------------------------------------------------
ANONYMOUS_GRANT_TTL=30 days
ANONYMOUS_PROJECT_TTL_DAYS=30
PROJECT_PURGE_GRACE_DAYS=7
QUEUE_DRIVER=database

#--------------------------------------------------------------------
# EasyPost (instant-quote shipping labels, bought on MakeXYZ's account)
#--------------------------------------------------------------------
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=

# MakeXYZ ship-from / return address for every instant-quote label
MAKEXYZ_SHIP_FROM_NAME=
MAKEXYZ_SHIP_FROM_COMPANY=
MAKEXYZ_SHIP_FROM_LINE1=
MAKEXYZ_SHIP_FROM_LINE2=
MAKEXYZ_SHIP_FROM_CITY=
MAKEXYZ_SHIP_FROM_STATE=
MAKEXYZ_SHIP_FROM_POSTAL_CODE=
MAKEXYZ_SHIP_FROM_COUNTRY=US
MAKEXYZ_SHIP_FROM_PHONE=
MAKEXYZ_SHIP_FROM_EMAIL=

#--------------------------------------------------------------------
# Vendor payouts (Stripe Connect / PayPal Payouts)
#--------------------------------------------------------------------
# Days after delivery before a payout is sent (per-vendor override exists)
PAYOUT_DEFAULT_HOLD_DAYS=10
# Frontend pages Stripe Connect onboarding returns to / restarts from
VENDOR_PAYOUT_ONBOARDING_RETURN_URL=
VENDOR_PAYOUT_ONBOARDING_REFRESH_URL=
# Log in with PayPal (must be enabled on the PayPal REST app)
PAYPAL_OAUTH_REDIRECT_URL=
PAYPAL_AUTHORIZE_BASE_URL=https://www.sandbox.paypal.com

#--------------------------------------------------------------------
# Vendor onboarding (see docs/VENDOR_ONBOARDING.md)
#--------------------------------------------------------------------
# Frontend page that handles invitation links - admins get
# ${ACCOUNT_INVITE_URL}?link=<signed API path> to share
ACCOUNT_INVITE_URL=
# Current vendor agreement version (e.g. 2026-09-01) - bump to require re-acceptance
VENDOR_AGREEMENT_VERSION=
