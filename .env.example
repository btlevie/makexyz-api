# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app

#--------------------------------------------------------------------
# AWS S3 (project file storage)
#--------------------------------------------------------------------
AWS_REGION=
S3_BUCKET=
S3_FILE_STORAGE_KEY=
DRIVE_DISK=s3

#--------------------------------------------------------------------
# Slicing microservice integration
#--------------------------------------------------------------------
SQS_SLICING_QUEUE_URL=
SLICER_CALLBACK_SECRET=

#--------------------------------------------------------------------
# Rate limiting (the instant-quote upload is public and costs money per
# call - every request writes to S3 and invokes the slicing Lambda)
#--------------------------------------------------------------------
LIMITER_STORE=database
INSTANT_QUOTE_RATE_LIMIT_REQUESTS=10
INSTANT_QUOTE_RATE_LIMIT_WINDOW=1 hour

#--------------------------------------------------------------------
# Anonymous instant-quote grants and abandoned-project cleanup
#--------------------------------------------------------------------
ANONYMOUS_GRANT_TTL=30 days
ANONYMOUS_PROJECT_TTL_DAYS=30
PROJECT_PURGE_GRACE_DAYS=7
QUEUE_DRIVER=database