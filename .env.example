# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app

#--------------------------------------------------------------------
# AWS S3 (project file storage)
#--------------------------------------------------------------------
AWS_REGION=
S3_BUCKET=
S3_FILE_STORAGE_KEY=
DRIVE_DISK=s3

#--------------------------------------------------------------------
# Slicing microservice integration
#--------------------------------------------------------------------
SQS_SLICING_QUEUE_URL=
SLICER_CALLBACK_SECRET=